# ─── Docker Environment Variables ────────────────────────────────────────────
# Used by docker-compose.yml for local development with PostgreSQL
# NEVER commit actual credentials - use strong passwords in production

# Database
DB_USER=peerforge
DB_PASSWORD=secure_dev_password_change_me_in_production
DB_NAME=peerforge
DB_HOST=db
DB_PORT=5432

# Connection string for backend (if needed)
# DATABASE_URL=postgresql://peerforge:secure_dev_password_change_me_in_production@db:5432/peerforge
