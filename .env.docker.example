# ─── Docker / Production Environment Variables ───────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env file — it is in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./PaperLens.db
# For PostgreSQL (Render/Fly/Railway):
# DATABASE_URL=postgresql://user:password@host:5432/paperlens

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace_with_output_of__python_-c__import_secrets_print_secrets.token_urlsafe_32__

# ── LLM API keys (fill in the ones you have) ─────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── SMTP — OTP email delivery ─────────────────────────────────────────────────
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=your_email@gmail.com

# ── Agent model config ────────────────────────────────────────────────────────
AGENT_MODEL_GROUP_A_PRIMARY=gemini-1.5-flash
AGENT_MODEL_GROUP_A_CRITIC=gemini-1.5-flash
AGENT_MODEL_GROUP_B_PRIMARY=llama-3.3-70b-versatile
AGENT_MODEL_GROUP_B_CRITIC=llama-3.3-70b-versatile
AGENT_MODEL_SYNTHESIZER=gemini-1.5-flash

ENABLE_CNN_FIGURES=true
AGENTIC_RAG_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL (space-separated for multiple origins).
# Example: FRONTEND_URL=https://paper-lens-liart.vercel.app
FRONTEND_URL=
# Set to false to disable *.vercel.app wildcard in CORS (tighten in production).
ALLOW_VERCEL_ORIGINS=true
